# CobraVoz — variables de entorno.
# En local NO hace falta rellenar esto a mano: `npm run db:start && npm run db:env`
# genera `.env.local` con los valores de Supabase local. Nunca commitees secretos.
# Arquitectura §11: las variables sin prefijo NEXT_PUBLIC_ son SOLO de servidor.

# ───────────── Públicas (visibles en el navegador) ─────────────
# URL base de la app (Preview/Production: https obligatorio).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Entorno lógico: local | preview | production. Controla si se permite el adaptador Pey simulado.
NEXT_PUBLIC_APP_ENV=local
# Supabase: URL y clave PUBLICABLE (nunca la secret / service-role key).
# Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ───────────── Solo servidor (no exponer jamás al cliente) ─────────────
# Clave secreta de Supabase (API admin de Auth). Solo la usan los seeds locales y, más adelante, tareas de servidor.
SUPABASE_SECRET_KEY=
# Base de datos: conexión pooled (transaction pooler) para runtime y conexión directa para migraciones.
# Local (ambas): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Pey / CoDi (H5): API key y secreto de firma de webhooks (Standard Webhooks).
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
# OpenAI STT (H6).
OPENAI_API_KEY=
# Secreto del cron de conciliación (H7).
CRON_SECRET=

# ───────────── Solo seed local (opcional) ─────────────
# Credenciales del usuario demo. Solo se usan con `npm run db:seed` contra una base local.
# SEED_USER_EMAIL=demo@cobravoz.local
# SEED_USER_PASSWORD=cobravoz-local-dev
